generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationRole {
  ADMIN
  MEMBER
}

enum CycleStatus {
  PLANNED
  ACTIVE
  CLOSED
}

enum ObjectiveStatus {
  NOT_STARTED
  ON_TRACK
  AT_RISK
  OFF_TRACK
  COMPLETED
  ARCHIVED
}

enum ObjectiveLevel {
  COMPANY
  TEAM
  INDIVIDUAL
}

enum ObjectiveVisibility {
  PUBLIC
  PRIVATE
}

enum KeyResultType {
  NUMBER
  PERCENTAGE
  CURRENCY
  BOOLEAN
}

enum MetricType {
  NUMBER
  PERCENTAGE
  CURRENCY
}

enum CheckInConfidence {
  HIGH
  MEDIUM
  LOW
}

enum CheckInCadence {
  NONE
  WEEKLY
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELED
}

model User {
  id        String           @id @default(cuid())
  email     String           @unique
  name      String?
  imageUrl  String?
  role      OrganizationRole @default(MEMBER)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  organizations              Organization[]     @relation("OrganizationMembers")
  ownedOrganizations         Organization[]     @relation("OrganizationOwner")
  workspaces                 Workspace[]        @relation("WorkspaceMembers")
  ledWorkspaces              Workspace[]        @relation("WorkspaceLead")
  ownedObjectives            Objective[]        @relation("ObjectiveOwner")
  createdObjectives          Objective[]        @relation("ObjectiveCreator")
  ownedKeyResults            KeyResult[]        @relation("KeyResultOwner")
  ownedMetrics               Metric[]           @relation("MetricOwner")
  checkIns                   CheckIn[]          @relation("CheckInAuthor")
  assignedTasks              Task[]             @relation("TaskAssignee")
  createdTasks               Task[]             @relation("TaskCreator")
  installedSlackIntegrations SlackIntegration[] @relation("SlackIntegrationInstaller")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  ownerId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner             User?              @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  members           User[]             @relation("OrganizationMembers")
  workspaces        Workspace[]
  cycles            Cycle[]
  objectives        Objective[]
  keyResults        KeyResult[]
  metrics           Metric[]
  checkIns          CheckIn[]
  tasks             Task[]
  slackIntegrations SlackIntegration[]
  githubIntegrations GitHubIntegration[]

  @@index([ownerId])
}

model Workspace {
  id             String   @id @default(cuid())
  name           String
  slug           String
  description    String?
  organizationId String
  leadId         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead              User?              @relation("WorkspaceLead", fields: [leadId], references: [id], onDelete: SetNull)
  members           User[]             @relation("WorkspaceMembers")
  cycles            Cycle[]
  objectives        Objective[]
  keyResults        KeyResult[]
  metrics           Metric[]
  checkIns          CheckIn[]
  tasks             Task[]
  slackIntegrations SlackIntegration[]
  githubIntegrations GitHubIntegration[]

  @@unique([organizationId, slug])
  @@index([leadId])
}

model Cycle {
  id             String      @id @default(cuid())
  name           String
  slug           String
  status         CycleStatus @default(PLANNED)
  startsAt       DateTime
  endsAt         DateTime
  organizationId String
  workspaceId    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  objectives   Objective[]

  @@unique([organizationId, slug])
  @@index([workspaceId])
  @@index([status])
}

model Objective {
  id                    String              @id @default(cuid())
  title                 String
  description           String?
  level                 ObjectiveLevel      @default(TEAM)
  status                ObjectiveStatus     @default(NOT_STARTED)
  visibility            ObjectiveVisibility @default(PUBLIC)
  progress              Float               @default(0)
  dueDate               DateTime?
  organizationId        String
  workspaceId           String?
  cycleId               String?
  ownerId               String?
  creatorId             String?
  parentObjectiveId     String?
  checkInCadence        CheckInCadence      @default(WEEKLY)
  lastCheckInReminderAt DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace       Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  cycle           Cycle?       @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  owner           User?        @relation("ObjectiveOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  creator         User?        @relation("ObjectiveCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  parentObjective Objective?   @relation("ObjectiveHierarchy", fields: [parentObjectiveId], references: [id], onDelete: SetNull)
  childObjectives Objective[]  @relation("ObjectiveHierarchy")
  keyResults      KeyResult[]
  checkIns        CheckIn[]
  tasks           Task[]

  @@index([organizationId])
  @@index([workspaceId])
  @@index([cycleId])
  @@index([ownerId])
  @@index([parentObjectiveId])
  @@index([status])
  @@index([visibility])
  @@index([checkInCadence])
}

model KeyResult {
  id                    String             @id @default(cuid())
  title                 String
  description           String?
  type                  KeyResultType      @default(NUMBER)
  startValue            Float              @default(0)
  targetValue           Float
  currentValue          Float              @default(0)
  unit                  String?
  confidence            CheckInConfidence?
  organizationId        String
  workspaceId           String?
  objectiveId           String
  ownerId               String?
  checkInCadence        CheckInCadence     @default(WEEKLY)
  lastCheckInReminderAt DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  objective    Objective    @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  owner        User?        @relation("KeyResultOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  checkIns     CheckIn[]
  tasks        Task[]
  githubIntegration GitHubIntegration?

  @@index([organizationId])
  @@index([workspaceId])
  @@index([objectiveId])
  @@index([ownerId])
  @@index([checkInCadence])
}

model Metric {
  id                    String         @id @default(cuid())
  title                 String
  description           String?
  type                  MetricType     @default(NUMBER)
  currentValue          Float          @default(0)
  targetValue           Float?
  unit                  String?
  checkInCadence        CheckInCadence @default(WEEKLY)
  lastCheckInReminderAt DateTime?
  organizationId        String
  workspaceId           String?
  ownerId               String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  owner        User?        @relation("MetricOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  checkIns     CheckIn[]

  @@index([organizationId])
  @@index([workspaceId])
  @@index([ownerId])
  @@index([type])
  @@index([checkInCadence])
}

model CheckIn {
  id             String            @id @default(cuid())
  note           String?
  confidence     CheckInConfidence
  progress       Float?
  value          Float?
  organizationId String
  workspaceId    String?
  objectiveId    String?
  keyResultId    String?
  metricId       String?
  authorId       String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  objective    Objective?   @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  keyResult    KeyResult?   @relation(fields: [keyResultId], references: [id], onDelete: Cascade)
  metric       Metric?      @relation(fields: [metricId], references: [id], onDelete: Cascade)
  author       User?        @relation("CheckInAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([workspaceId])
  @@index([objectiveId])
  @@index([keyResultId])
  @@index([metricId])
  @@index([authorId])
  @@index([createdAt])
}

model Task {
  id             String     @id @default(cuid())
  title          String
  description    String?
  status         TaskStatus @default(TODO)
  dueDate        DateTime?
  completedAt    DateTime?
  organizationId String
  workspaceId    String?
  objectiveId    String?
  keyResultId    String?
  assigneeId     String?
  creatorId      String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  objective    Objective?   @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  keyResult    KeyResult?   @relation(fields: [keyResultId], references: [id], onDelete: Cascade)
  assignee     User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator      User?        @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([workspaceId])
  @@index([objectiveId])
  @@index([keyResultId])
  @@index([assigneeId])
  @@index([creatorId])
  @@index([status])
}

model SlackIntegration {
  id                String   @id @default(cuid())
  teamId            String   @unique
  teamName          String?
  channelId         String?
  channelName       String?
  botUserId         String?
  botAccessToken    String
  organizationId    String
  workspaceId       String?
  installedByUserId String?
  installedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace       Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  installedByUser User?        @relation("SlackIntegrationInstaller", fields: [installedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([workspaceId])
  @@index([channelId])
  @@index([installedByUserId])
}

model GitHubIntegration {
  id                       String   @id @default(cuid())
  repository               String
  branch                   String?
  incrementBy              Float    @default(1)
  keyResultId              String   @unique
  organizationId           String
  workspaceId              String?
  lastDeliveryId           String?
  lastMergedPullRequestUrl String?
  lastMergedAt             DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  keyResult    KeyResult    @relation(fields: [keyResultId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([workspaceId])
  @@index([repository])
  @@index([branch])
}
